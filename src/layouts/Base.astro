---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, business } from '../lib/site';
import { pageSchema } from '../lib/seo';
import { city } from '../data/city';
import { u } from '../lib/utils';
import RequestForm from '../components/RequestForm.astro';
import Callout from '../components/Callout.astro';
const { title, description, path, crumbs = [], extraSchema = [], service = false, noCallout = false } = Astro.props;
const loc = path === '/' ? 'Homepage' : path === '/privacy/' ? 'Privacy' : path === '/terms/' ? 'Terms' : (crumbs.length ? crumbs[crumbs.length - 1].name : 'Page');
const canonical = `${SITE_URL}${path}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a5a94" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <JsonLd data={pageSchema(path, title, description, crumbs, service)} />
    {extraSchema.map((s) => <JsonLd data={s} />)}
  {city.site.ga4MeasurementId && <><script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${city.site.ga4MeasurementId}`}></script><script is:inline define:vars={{measurementId:city.site.ga4MeasurementId}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',measurementId);</script></>}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <SiteHeader />
    <div class="status-strip"><div class="status-inner"><span class="status-text"><span class="status-dot" aria-hidden="true"></span>{city.ui.statusStrip}</span><a href={business.phoneHref}>{business.phoneDisplay}</a></div></div>
    <main id="main"><slot />
      
      {!noCallout && <Callout />}
    </main>
    <SiteFooter />
    <a class="sticky-call" href={business.phoneHref} aria-label={`Call ${business.phoneDisplay}`}><span class="phone-shake" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.9.6.6 0 1 .4 1 1v3.5c0 .6-.4 1-1 1C10.8 21 3 13.2 3 3.6c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.4.2 2.7.6 3.9.1.4 0 .8-.3 1.1l-2.2 2.2z"/></svg></span>Call {business.phoneDisplay}</a>
    <style is:global>
      body { padding-bottom:88px; }
      .sticky-call { position:fixed;bottom:18px;right:18px;left:auto;z-index:1000;border-radius:999px;display:flex;align-items:center;justify-content:center;gap:12px;padding:17px 26px;background:#ffc527;color:#000;text-decoration:none;font-weight:700;box-shadow:0 8px 28px #0005;border-radius:8px;overflow:hidden; }
      .sticky-call::after {content:'';position:absolute;inset:0;background:linear-gradient(110deg,transparent 30%,#ffffff65 50%,transparent 70%);transform:translateX(-140%);animation:call-shimmer 4s infinite;pointer-events:none;}
      .phone-shake {display:flex;animation:phone-shake 4s infinite;transform-origin:center;}
      @keyframes call-shimmer {0%,55%{transform:translateX(-140%)}85%,100%{transform:translateX(140%)}}
      @keyframes phone-shake {0%,60%,100%{transform:rotate(0)}65%,75%,85%{transform:rotate(-16deg)}70%,80%,90%{transform:rotate(16deg)}}
      @media(max-width:600px){.sticky-call{bottom:12px;right:12px;white-space:nowrap;padding:14px 18px;}}
      @media(prefers-reduced-motion:reduce){.sticky-call::after,.phone-shake{animation:none;}}
    </style>
    <script>import '../scripts/lead-form.js';</script>
    <script>import '../scripts/fx.js';</script>
    <script is:inline defer src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id={city.site.airchattyTrackingId}></script>
  </body>
</html>
