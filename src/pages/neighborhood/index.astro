---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import { city, neighborhoods } from '../../data/city';
import { u } from '../../lib/utils';
const c = city.indexPages.neighborhoods;
---
<Base noFormBand={true} title={c.title} description={c.desc} path="/neighborhood/" crumbs={[{ name: 'Neighborhoods', path: '/neighborhood/' }]}>
  <Hero headline={c.h1} intro={c.intro} location="Neighborhoods" crumbs={[{ href: '/neighborhood/', label: 'Neighborhoods' }]} />
  <section class="content-section"><div class="content-inner">
    <div class="card-grid">
      {neighborhoods.map((n, i) => <article class="card"><p class="eyebrow">Local area {String(i + 1).padStart(2, '0')}</p><h3><a href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a></h3><p>{n.intro}</p></article>)}
    </div>
  </div></section>
</Base>
