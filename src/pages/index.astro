---
import Base from '../layouts/Base.astro';
import RequestForm from '../components/RequestForm.astro';
import { city, C, services, guides, neighborhoods } from '../data/city';
import { faqSchema } from '../lib/seo';
import { business } from '../lib/site';
import { u } from '../lib/utils';
import { pageImage } from '../lib/pageImages';
const home = city.home;
const [s1, s2, s3, s4] = home.sections;
const faqs = home.faqs;
const steps = home.steps;
const svcImgs = services.map((s) => pageImage(s.slug + s.name));
const aboutImg = pageImage('about-' + home.h1);
---
<Base title={home.title} description={home.desc} path="/" extraSchema={[faqSchema(faqs)]} noFormBand={true}>
  <section class="hero" data-parallax-stage>
    <div class="fx-circle fx-fill fx-float" data-depth="16" style="width:480px;height:480px;left:-180px;top:-200px" aria-hidden="true"></div>
    <div class="fx-circle fx-ring fx-float-slow" data-depth="28" style="width:160px;height:160px;right:34%;bottom:-60px" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-copy-col reveal">
        <p class="chip">{city.ui.heroEyebrow}</p>
        <h1>{home.h1}</h1>
        <p class="hero-copy">{home.intro}</p>
        <div class="hero-cta">
          <a class="button-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
          <a class="link-underline" href={u('/services/')}>Explore services</a>
        </div>
            </div>
      <div class="hero-form-wrap reveal" style="--reveal-delay:.15s">
        <div class="fx-circle fx-dot fx-float" data-depth="26" style="width:20px;height:20px;left:-30px;top:10%" aria-hidden="true"></div>
        <RequestForm location="Homepage" />
      </div>
    </div>
  </section>

  <section class="content-section"><div class="content-inner about-grid">
    <div class="about-photo reveal" data-parallax-stage>
      <div class="fx-circle fx-ring-blue fx-float-slow" data-depth="14" style="width:120px;height:120px;left:-40px;top:-40px" aria-hidden="true"></div>
      <img src={u(aboutImg.src)} alt={aboutImg.alt} width="900" height="640" loading="lazy" decoding="async" />
      <div class="about-experience"><strong data-count-to={neighborhoods.length}>0</strong><span>Local areas</span></div>
    </div>
    <div class="about-copy reveal" style="--reveal-delay:.12s">
      <p class="eyebrow">{city.site.niche}</p>
      <h2 class="section-title">{s4.h}</h2>
      {s4.ps.map((p) => <p class="section-intro" set:html={p} />)}
      <a class="button-primary" href="#request-service">Request service</a>
    </div>
  </div></section>

  <section class="content-section content-section-alt" data-parallax-stage>
    <div class="fx-circle fx-ring-blue fx-float" data-depth="16" style="width:200px;height:200px;right:-80px;top:-70px" aria-hidden="true"></div>
    <div class="content-inner">
      <div class="section-head reveal">
        <div><p class="eyebrow">Services</p><h2 class="section-title" style="margin:0">{s1.h}</h2></div>
        <a class="button-soft" href={u('/services/')}>View all</a>
      </div>
      <p class="section-intro reveal" style="margin-bottom:36px">{s1.ps[0]}</p>
      <div class="card-grid">
        {services.map((s, i) => (
          <article class="svc-card reveal" style={`--reveal-delay:${i * 0.12}s`}>
            <a class="svc-media" href={u(`/services/${s.slug}/`)} tabindex="-1" aria-hidden="true"><img src={u(svcImgs[i].src)} alt={svcImgs[i].alt} width="800" height="500" loading="lazy" decoding="async" /></a>
            <div class="svc-body">
              <h3><a href={u(`/services/${s.slug}/`)}>{s.name}</a></h3>
              <p>{s.blurb}</p>
              <a class="link-underline" href={u(`/services/${s.slug}/`)}>Read more</a>
            </div>
          </article>
        ))}
      </div>
      <div class="feature-strip">
        {steps.map((s, i) => (
          <article class="feature reveal" style={`--reveal-delay:${i * 0.12}s`}>
            <span class="feature-dot">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{s.t}</h3><p>{s.d}</p></div>
          </article>
        ))}
      </div>
      <div class="related-links reveal" style="margin-top:34px">
        {guides.map((g) => <a class="pill" href={u(`/guides/${g.slug}/`)}>{g.name}</a>)}
      </div>
    </div>
  </section>

  <section class="dark-band" data-parallax-stage>
    <div class="fx-circle fx-ring fx-float" data-depth="20" style="width:260px;height:260px;right:-100px;top:-110px;opacity:.4" aria-hidden="true"></div>
    <div class="dark-grid">
      <div class="reveal">
        <p class="eyebrow eyebrow-light">Local area pages</p>
        <h2 class="section-title section-title-light">{s3.h}</h2>
        <p class="band-text">{home.bandText}</p>
        <div class="pill-grid pill-grid-dark">{neighborhoods.map((n) => <a class="pill" href={u(`/neighborhood/${n.slug}/`)}>{n.name}</a>)}</div>
      </div>
      <aside class="dispatch-card reveal" style="--reveal-delay:.15s"><p class="eyebrow">Phone line</p><h3>{home.dispatchTitle}</h3><p>{home.dispatchText}</p><a class="button-dark" href={business.phoneHref}>Call {business.phoneDisplay}</a></aside>
    </div>
  </section>

  <section class="content-section"><div class="content-inner">
    <div class="reveal"><p class="eyebrow">Before you book</p><h2 class="section-title">{s2.h}</h2></div>
    {s2.ps.map((p) => <p class="section-intro reveal" style="margin-bottom:14px" set:html={p} />)}
  </div></section>

  <section class="content-section content-section-alt"><div class="content-inner acc-grid">
    <div class="reveal">
      <p class="eyebrow">Questions</p>
      <h2 class="section-title">{home.faqHeading}</h2>
      <p class="section-intro" style="margin-bottom:24px">{city.ui.calloutText}</p>
      <a class="button-primary" href={business.phoneHref}>Call {business.phoneDisplay}</a>
    </div>
    <div class="acc reveal" style="--reveal-delay:.12s">
      {faqs.map((f, i) => (
        <div class:list={['acc-item', { open: i === 0 }]} data-acc-item>
          <button class="acc-toggle" type="button" data-acc-toggle aria-expanded={i === 0 ? 'true' : 'false'}>
            <h3>{f.q}</h3>
            <span class="acc-icon" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6.5 1v11M1 6.5h11"/></svg></span>
          </button>
          <div class="acc-panel" data-acc-panel aria-hidden={i === 0 ? 'false' : 'true'}><div class="acc-panel-inner"><p>{f.a}</p></div></div>
        </div>
      ))}
    </div>
  </div></section>
<section class="nh-body"><div class="nh-inner"><p set:html={home.footerLinksHtml.replace(/href="(\/[^"]*)"/g, (_m, h) => 'href="' + u(h) + '"')} /></div></section>
</Base>
